---
import { getCollection } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import Dlazdice from '../components/Dlazdice.astro';
import KrokNaDnes from '../components/KrokNaDnes.astro';
import { PILIRE } from '../lib/pilire';

const pribehy = (await getCollection('obsah', (s) => s.id.startsWith('pribehy/'))).sort((a, b) => a.data.poradi - b.data.poradi).slice(0, 3);
const pilire = (['scenar', 'pribehy', 'priprav-se', 'manipulace'] as const).map((p) => ({ p, ...PILIRE[p] }));
const popisy: Record<string, string> = {
  scenar: 'Co by znamenal útok Ruska na NATO pro nás: drony, sabotáže, výpadky a panika. A co by fungovalo dál.',
  pribehy: 'Rodina u dálnice, paní Věra v paneláku, student a TikTok. Co jim pomohlo a co chybělo.',
  'priprav-se': 'Rodinný plán, kontrolní seznam, informace bez internetu a péče o ty, kdo potřebují pomoc.',
  manipulace: 'Šest triků, které by se v krizi objevily. Když je poznáte předem, přestanou fungovat.',
};
---
<Zaklad title="Víme, co dělat">
  <section class="uvod">
    <img class="foto" src="/obrazky/hero-domov.jpg" alt="" fetchpriority="high" />
    <span class="puvod">Ilustrační obrázek vytvořený pomocí AI</span>
    <div class="obal">
      <div class="obsah-uvodu">
        <p class="znacka">Nezávislý projekt · Připravenost · Odolnost</p>
        <h1>Počítáme s tím.<br /><span class="zlute">Připravme se.</span></h1>
        <p class="perex">Rusko může zaútočit na NATO, a tím i na nás. Kdy a jestli vůbec, nikdo neví. Je lepší být připraven než překvapen. Narovinu vysvětlujeme, co by to znamenalo, jak se postarat o sebe i své blízké a jak poznat manipulaci dřív, než na ni narazíte.</p>
        <div class="akce">
          <a class="tlacitko lampa" href="/zacit">Co by to znamenalo pro nás <span aria-hidden="true">→</span></a>
          <a class="tlacitko obrys" href="/priprav-se/rodinny-plan">Rodinný plán za 15 minut <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="obal">
    <h2>Válka se dnes nevyhlašuje</h2>
    <p class="text">Rusko proti Česku i Evropě už teď vede nepřátelské operace: sabotáže, kybernetické útoky, dezinformace. Čím dřív si to připustíme, tím líp se připravíme.</p>
    <div class="mrizka">
      <Dlazdice href="/scenar/jsme-ve-valce" titulek="Jsme ve válce?" popis="Co už se u nás a v Evropě stalo, kde je hranice a co by znamenalo, kdyby válka začala i formálně." cislo="Teď" zvyraznit />
      <Dlazdice href="/scenar/co-rikaji-zpravodajci" titulek="Co říkají ti, kdo to vědí" popis="BIS, armáda a zahraniční zpravodajské služby jejich vlastními slovy. Kdo varuje a před čím." cislo="Zdroje" />
      <Dlazdice href="/scenar/utok-na-elektrickou-sit" titulek="Útok na elektrickou síť" popis="Co se stane, když vypadne proud v celé zemi. První hodina, první den, třetí den." cislo="Scénář" />
    </div>
  </section>

  <section class="obal">
    <h2>Čtyři části</h2>
    <div class="mrizka">
      {pilire.map((x) => <Dlazdice href={`/${x.p}`} titulek={x.nazev} popis={popisy[x.p]} cislo={`0${x.cislo}`} />)}
    </div>
  </section>

  <section class="obal">
    <h2>Co si odnesete</h2>
    <div class="mrizka">
      <Dlazdice href="/priprav-se/rodinny-plan" titulek="Rodinný plán na A4" popis="Místo setkání, kdo vyzvedne děti, kontakty na papíře, léky a plán bez signálu." cislo="Nástroj" zvyraznit />
      <Dlazdice href="/priprav-se/kontrolni-seznam" titulek="Kontrolní seznam" popis="Co už máte a co chybí. Zaškrtáváte jen pro sebe, nic se neodesílá." cislo="Nástroj" zvyraznit />
      <Dlazdice href="/manipulace/karta" titulek="Kapesní karta" popis="Šest technik manipulace a šest otázek. Do peněženky i do telefonu." cislo="Nástroj" zvyraznit />
    </div>
  </section>

  {pribehy.length > 0 && (
    <section class="obal">
      <h2>Příběhy</h2>
      <p class="text">Modelové příběhy jsou fiktivní postavy v realistických situacích. Vždy je tak označujeme.</p>
      <div class="mrizka">
        {pribehy.map((s) => <Dlazdice href={`/${s.id}`} titulek={s.data.title} popis={s.data.popis} druh={s.data.druh} doplnek={s.data.cteni ? `${s.data.cteni} min čtení` : undefined} />)}
      </div>
    </section>
  )}

  <section class="pas">
    <div class="obal">
      <h2>Co můžu udělat já</h2>
      <p class="text">Připravená rodina je základ. Země ale potřebuje i lidi, kteří umějí pomoct ostatním.</p>
      <div class="mrizka">
        <Dlazdice href="/priprav-se/aktivni-zaloha" titulek="Zvažte aktivní zálohu" popis="Výcvik pár týdnů v roce vedle běžné práce. Pro koho je a jak se přihlásit." cislo="Zapoj se" />
        <Dlazdice href="/priprav-se/co-mohu-udelat-ja" titulek="Další cesty, jak pomoct" popis="Dobrovolní hasiči, první pomoc, Červený kříž, dárcovství krve, pomoc v obci." cislo="Zapoj se" />
        <Dlazdice href="/priprav-se/kondice" titulek="Udržte se v kondici" popis="V krizi se chodí pěšky, nosí voda a málo spí. Jednoduchý plán pro každého." cislo="Zapoj se" />
      </div>
    </div>
  </section>

  <section class="obal">
    <KrokNaDnes text="Domluvte se s rodinou, kde se sejdete, když nepůjdou telefony." />
  </section>

  <section class="obal nezavislost">
    <h2>Nezávislí a nadstraničtí</h2>
    <p class="text">Za projektem nestojí žádná politická strana ani politik. Nebereme peníze od stran ani od zbrojařských firem. Seznam dárců, redakční pravidla i všechny opravy jsou veřejné.</p>
    <p class="odkazy"><a href="/o-nas/financovani">Kdo nás financuje →</a> <a href="/o-nas/redakcni-pravidla">Jak pracujeme →</a> <a href="/o-nas/opravy">Opravy →</a></p>
  </section>
</Zaklad>

<style>
  .uvod { position: relative; overflow: hidden; background: var(--tmava); color: #fff; padding: clamp(3rem, 8vw, 6.5rem) 0 clamp(2.5rem, 6vw, 4.5rem); border-bottom: 8px solid var(--akcent); }
  .uvod .obal { position: relative; z-index: 1; }
  .uvod .obsah-uvodu { max-width: 46rem; }
  .uvod h1 { font-size: clamp(2.9rem, 6.2vw, 5.4rem); line-height: 0.95; margin: 1.2rem 0 1.6rem; }
  .foto { position: absolute; top: 0; right: 0; width: 62%; height: 100%; object-fit: cover; object-position: 62% 50%; filter: brightness(1.3) contrast(1.05); }
  .uvod::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--tmava) 0%, var(--tmava) 38%, rgb(31 35 40 / 0.55) 58%, rgb(31 35 40 / 0.1) 80%, rgb(31 35 40 / 0) 100%); }
  .zlute { color: var(--akcent-na-tmave); }
  .perex { font-size: clamp(1.1rem, 1.8vw, 1.3rem); line-height: 1.5; margin: 0 0 1.6rem; max-width: 38rem; }
  .akce { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .tlacitko.obrys { background: transparent; color: #fff; border-color: #fff; }
  .tlacitko.obrys:hover { background: var(--akcent); color: var(--na-akcentu); border-color: var(--akcent); }
  .puvod { position: absolute; right: 0; bottom: 0; z-index: 2; background: rgb(0 0 0 / 0.6); font-family: var(--pismo-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.25rem 0.5rem; }
  .mrizka { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr)); }
  .pas { background: var(--papir-2); margin-top: 3.5rem; padding: 0.5rem 0 2.5rem; border-top: 2px solid var(--linka); border-bottom: 2px solid var(--linka); }
  .odkazy { display: flex; gap: 1.5rem; flex-wrap: wrap; font-weight: 700; }
  @media (max-width: 800px) {
    .uvod { padding-top: 0; }
    .foto { position: relative; width: 100%; height: 15rem; display: block; margin-bottom: 1.5rem; object-position: 62% 50%; }
    .uvod::after { display: none; }
    .puvod { top: 14rem; bottom: auto; }
  }
</style>
