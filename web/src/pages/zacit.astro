---
import Obrazek from '../components/Obrazek.astro';
import Zaklad from '../layouts/Zaklad.astro';
---
<Zaklad title="Co by to znamenalo pro nás?" popis="Pět otázek o vaší domácnosti. Ukážeme vám, čím začít. Odpovědi se nikam neukládají ani neodesílají.">
  <section class="obal pruvodce">
    <h1>Co by to znamenalo pro nás?</h1>
    <p class="perex text">Pět krátkých otázek o vaší domácnosti. Podle odpovědí vám ukážeme, čím začít. <strong>Odpovědi se nikam neukládají ani neodesílají.</strong> Zůstávají jen na této stránce.</p>
    <div class="text ilustrace netisknout"><Obrazek src="/obrazky/stranky/zacit.jpg" alt="Stůl u okna se zápisníkem, lístečky s otazníky a hrnkem čaje" vyska="clamp(12rem, 30vw, 20rem)" nacist="hned" /></div>

    <form id="pruvodce" class="text">
      <fieldset>
        <legend><span class="cislo">1</span> Kdo s vámi žije?</legend>
        <p class="napoveda">Můžete vybrat víc možností.</p>
        <label><input type="checkbox" name="kdo" value="male-deti" /> Děti do 6 let</label>
        <label><input type="checkbox" name="kdo" value="skolni-deti" /> Školní děti</label>
        <label><input type="checkbox" name="kdo" value="senior" /> Senior nebo seniorka</label>
        <label><input type="checkbox" name="kdo" value="postizeni" /> Člověk s postižením nebo dlouhodobou nemocí</label>
        <label><input type="checkbox" name="kdo" value="zvirata" /> Domácí zvířata</label>
        <label><input type="checkbox" name="kdo" value="sam" /> Bydlím sám nebo sama</label>
      </fieldset>

      <fieldset>
        <legend><span class="cislo">2</span> Potřebuje někdo pravidelné léky nebo přístroj na elektřinu?</legend>
        <label><input type="checkbox" name="zdravi" value="leky" /> Pravidelné léky</label>
        <label><input type="checkbox" name="zdravi" value="lednice" /> Léky, které musí být v lednici (např. inzulin)</label>
        <label><input type="checkbox" name="zdravi" value="pristroj" /> Přístroj na elektřinu (kyslík, dialýza, polohovací lůžko…)</label>
      </fieldset>

      <fieldset>
        <legend><span class="cislo">3</span> Kde bydlíte?</legend>
        <label><input type="radio" name="bydleni" value="byt" /> V bytě</label>
        <label><input type="radio" name="bydleni" value="dum" /> V rodinném domě</label>
      </fieldset>

      <fieldset>
        <legend><span class="cislo">4</span> Máte auto?</legend>
        <label><input type="radio" name="auto" value="ano" /> Ano</label>
        <label><input type="radio" name="auto" value="ne" /> Ne</label>
      </fieldset>

      <fieldset>
        <legend><span class="cislo">5</span> Jaké je vaše okolí?</legend>
        <label><input type="radio" name="misto" value="velke-mesto" /> Velké město</label>
        <label><input type="radio" name="misto" value="mesto" /> Menší město</label>
        <label><input type="radio" name="misto" value="obec" /> Malá obec</label>
        <label class="oddelit"><input type="checkbox" name="doprava" value="ano" /> Bydlíme blízko dálnice nebo železnice</label>
      </fieldset>

      <button type="submit" class="tlacitko lampa">Ukázat, čím začít</button>
    </form>

    <section id="vysledek" class="vysledek text" hidden aria-live="polite" tabindex="-1">
      <h2>Čím začít</h2>
      <p>Seřadili jsme kroky podle toho, co vám pomůže nejvíc. Nejde o žádné hodnocení, jen o pořadí.</p>
      <ol id="doporuceni"></ol>
      <p><button type="button" class="tlacitko svetle" id="znovu">Upravit odpovědi</button></p>
    </section>

    <noscript>
      <p class="text">Průvodce potřebuje JavaScript. Bez něj doporučujeme začít tady: <a href="/priprav-se/rodinny-plan">rodinný plán</a>, <a href="/priprav-se/kontrolni-seznam">kontrolní seznam</a>, <a href="/priprav-se/informace-bez-internetu">informace bez internetu</a> a <a href="/manipulace/karta">kapesní karta</a>.</p>
    </noscript>
  </section>
</Zaklad>

<style>
  .pruvodce { padding-top: 2rem; }
  .perex { font-size: 1.2rem; color: var(--text-2); }
  .ilustrace { margin: 0 0 2rem; }
  fieldset { border: 2px solid var(--linka); background: var(--plocha); padding: 1.1rem 1.3rem 1.2rem; margin: 0 0 1rem; }
  legend { font-family: var(--pismo-nadpis); font-weight: var(--nadpis-vaha); font-size: 1.5rem; line-height: var(--nadpis-lh); padding: 0 0.4rem; display: flex; gap: 0.6rem; align-items: center; }
  .cislo { display: inline-grid; place-items: center; width: 1.8rem; height: 1.8rem; background: var(--tmava); color: var(--akcent); font-family: var(--pismo-mono); font-size: 0.95rem; flex: none; }
  .napoveda { margin: 0 0 0.5rem; color: var(--text-2); font-size: 0.95rem; }
  label { display: flex; gap: 0.7rem; align-items: center; padding: 0.45rem 0; cursor: pointer; }
  input[type='checkbox'], input[type='radio'] { width: 1.3rem; height: 1.3rem; flex: none; accent-color: var(--petrol); }
  .oddelit { border-top: 1px dashed var(--linka); margin-top: 0.4rem; padding-top: 0.8rem; }
  .vysledek { margin-top: 1rem; }
  #doporuceni { padding-left: 0; list-style: none; counter-reset: krok; }
  #doporuceni li { counter-increment: krok; background: var(--plocha); border: 1px solid var(--linka); border-left: 5px solid var(--salvej); border-radius: var(--radius); padding: 1rem 1.2rem 1rem 3.4rem; margin: 0.75rem 0; position: relative; }
  #doporuceni li::before { content: counter(krok); position: absolute; left: 1rem; top: 1rem; width: 1.7rem; height: 1.7rem; background: var(--tmava); color: var(--akcent); font-family: var(--pismo-mono); display: grid; place-items: center; font-weight: 700; font-size: 0.9rem; }
  #doporuceni a { font-weight: 700; }
  #doporuceni p { margin: 0.25rem 0 0; color: var(--text-2); font-size: 0.98rem; }
</style>

<script>
  type Krok = { href: string; nazev: string; proc: string; vaha: number };

  const formular = document.getElementById('pruvodce') as HTMLFormElement;
  const vysledek = document.getElementById('vysledek') as HTMLElement;
  const seznam = document.getElementById('doporuceni') as HTMLOListElement;

  function doporuc(data: FormData): Krok[] {
    const kdo = data.getAll('kdo');
    const zdravi = data.getAll('zdravi');
    const ma = (pole: FormDataEntryValue[], hodnota: string) => pole.includes(hodnota);
    const kroky: Krok[] = [
      { href: '/priprav-se/rodinny-plan', nazev: 'Rodinný plán na jednu stránku', proc: 'Kde se sejdete a jak se domluvíte bez signálu. Je to nejdůležitější krok pro každou domácnost.', vaha: 100 },
      { href: '/priprav-se/kontrolni-seznam', nazev: 'Kontrolní seznam', proc: 'Voda, jídlo, světlo a léky na tři dny podle 72h.gov.cz.', vaha: 80 },
      { href: '/priprav-se/informace-bez-internetu', nazev: 'Informace bez internetu', proc: 'Rádio na baterky, sirény a varovné zprávy do mobilu.', vaha: 70 },
      { href: '/manipulace/karta', nazev: 'Kapesní karta Poznej manipulaci', proc: 'Šest otázek, které si položit, než něco pošlete dál.', vaha: 60 },
    ];

    const deti = ma(kdo, 'male-deti') || ma(kdo, 'skolni-deti');
    if (deti) {
      kroky.push({ href: '/pribehy/rodina-u-dalnice', nazev: 'Příběh: Rodina u dálnice', proc: 'Kdo vyzvedne děti, když jsou rodiče v práci a nefungují telefony.', vaha: 95 });
      kroky.push({ href: '/priprav-se/psychika', nazev: 'Jak mluvit s dětmi o zprávách', proc: 'Děti poznají, když máte strach. Pomůže klid a jednoduchá vysvětlení.', vaha: 75 });
    }
    if (ma(kdo, 'senior') || ma(kdo, 'postizeni') || ma(kdo, 'zvirata') || zdravi.length > 0) {
      const proc = zdravi.includes('pristroj')
        ? 'Přístroj na elektřinu potřebuje plán pro výpadek proudu. Domluvte ho předem s lékařem a s blízkými.'
        : zdravi.includes('lednice')
          ? 'Léky v lednici potřebují plán pro výpadek proudu.'
          : 'Jak se postarat o ty, kdo potřebují víc pomoci.';
      kroky.push({ href: '/priprav-se/zranitelni', nazev: 'Péče o zranitelné', proc, vaha: zdravi.includes('pristroj') || zdravi.includes('lednice') ? 98 : 85 });
    }
    if (ma(kdo, 'senior') || (data.get('bydleni') === 'byt' && ma(kdo, 'sam'))) {
      kroky.push({ href: '/pribehy/pani-vera', nazev: 'Příběh: Paní Věra', proc: 'Tři dny bez proudu v paneláku. Co pomohlo a proč se vyplatí znát sousedy.', vaha: 72 });
    }
    if (ma(kdo, 'skolni-deti')) {
      kroky.push({ href: '/pribehy/student', nazev: 'Příběh: Student a TikTok', proc: 'Jak poznat falešné video a jak o tom mluvit doma.', vaha: 65 });
    }
    if (data.get('doprava') === 'ano') {
      kroky.push({ href: '/scenar/co-nas-zasahne', nazev: 'Co by nás mohlo zasáhnout doma', proc: 'Blízko dálnice nebo železnice můžete častěji vidět přesuny techniky a omezení dopravy.', vaha: 68 });
    }
    if (data.get('misto') === 'obec') {
      kroky.push({ href: '/scenar/co-bude-fungovat', nazev: 'Co by fungovalo dál', proc: 'Co dělá obec, záchranné složky a zásobování.', vaha: 55 });
    }
    if (data.get('auto') === 'ne') {
      kroky.push({ href: 'https://www.72h.gov.cz/cs/evakuace', nazev: 'Evakuace bez auta (72h.gov.cz)', proc: 'Domluvte si předem, kdo by vás odvezl, nebo kam se dostanete pěšky či veřejnou dopravou.', vaha: 58 });
    }
    kroky.push({ href: '/scenar/proc-tyl', nazev: 'Proč Česko nebude fronta, ale týl', proc: 'Co by se u nás pravděpodobně dělo a co ne.', vaha: 50 });
    kroky.push({ href: '/priprav-se/psychika', nazev: 'Jak zvládat úzkost', proc: 'Kdy vypnout zprávy a jak si udržet klid.', vaha: 40 });

    const videno = new Set<string>();
    return kroky
      .sort((a, b) => b.vaha - a.vaha)
      .filter((k) => (videno.has(k.href) ? false : (videno.add(k.href), true)))
      .slice(0, 8);
  }

  formular.addEventListener('submit', (udalost) => {
    udalost.preventDefault();
    seznam.replaceChildren(
      ...doporuc(new FormData(formular)).map((k) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = k.href;
        a.textContent = k.nazev;
        const p = document.createElement('p');
        p.textContent = k.proc;
        li.append(a, p);
        return li;
      }),
    );
    vysledek.hidden = false;
    vysledek.focus();
    vysledek.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document.getElementById('znovu')?.addEventListener('click', () => {
    formular.scrollIntoView({ behavior: 'smooth' });
  });
</script>
