---
import { getCollection, render } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import KrokNaDnes from '../components/KrokNaDnes.astro';
import OdkudToVime from '../components/OdkudToVime.astro';
import Revize from '../components/Revize.astro';
import StitekPribehu from '../components/StitekPribehu.astro';
import KapesniKarta from '../components/KapesniKarta.astro';
import Prirucky from '../components/Prirucky.astro';
import Drobky from '../components/Drobky.astro';
import Souvisejici from '../components/Souvisejici.astro';
import { PILIRE, pilirZId } from '../lib/pilire';

export async function getStaticPaths() {
  const stranky = await getCollection('obsah');
  return stranky.map((stranka) => ({ params: { slug: stranka.id }, props: { stranka } }));
}

const { stranka } = Astro.props;
const { Content } = await render(stranka);
const d = stranka.data;
const pilir = pilirZId(stranka.id);
const info = PILIRE[pilir];
const jePribeh = pilir === 'pribehy';
---
<Zaklad title={d.title} popis={d.popis} obrazek={`/og/${pilir}.png`}>
  <article class="obal stranka" style={`--barva-pilire: ${info.barva}`} data-pagefind-body>
    <Drobky pilir={pilir} />
    <header class="text">
      <p class="znacka" data-pagefind-ignore>{info.cislo ? `0${info.cislo} · ` : ''}{info.nazev}</p>
      <h1>{d.title}</h1>
      <div class="meta" data-pagefind-ignore>
        <StitekPribehu druh={d.druh} />
        {d.cteni && <span>{d.cteni} min čtení</span>}
      </div>
      <p class="perex">{d.popis}</p>
    </header>
    <div class:list={['text', 'telo', { cteni: jePribeh }]}>
      <Content />
    </div>
    {stranka.id === 'manipulace/karta' && <KapesniKarta />}
    {stranka.id === 'priprav-se/jak-se-pripravuji-jinde' && <Prirucky />}
    {d.krok && <KrokNaDnes text={d.krok} />}
    <OdkudToVime zdroje={d.zdroje} />
    <Revize autor={d.autor} recenze={d.recenze} revidovano={d.revidovano} stav={d.stav} id={d.id} />
    <Souvisejici pilir={pilir} aktualni={stranka.id} />
  </article>
</Zaklad>

<style>
  .stranka { padding-top: 1.5rem; }
  header h1 { margin-top: 0.9rem; }
  .meta { display: flex; gap: 1rem; align-items: center; font-family: var(--pismo-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-2); margin-bottom: 1rem; flex-wrap: wrap; }
  .perex { font-size: 1.3rem; line-height: 1.45; font-weight: 700; margin: 0 0 2rem; padding-left: 1rem; border-left: 6px solid var(--akcent); }
  .telo :global(h2) { padding-top: 0.9rem; border-top: 2px solid var(--linka); }
  .telo :global(h2:first-child) { margin-top: 0.5rem; }
  .telo :global(li) { margin: 0.35rem 0; }
  .telo :global(li::marker) { color: var(--text); font-weight: 700; }
  /* Na telefonu se široké tabulky skládají do karet, aby byl vidět každý sloupec. */
  @media (max-width: 700px) {
    .telo :global(table:has(td:nth-child(3))) { display: block; overflow: visible; }
    .telo :global(table:has(td:nth-child(3)) thead) { display: none; }
    .telo :global(table:has(td:nth-child(3)) :is(tbody, tr, td)) { display: block; }
    .telo :global(table:has(td:nth-child(3)) tr) { border: 2px solid var(--linka); background: var(--plocha); padding: 0.8rem 0.9rem; margin-bottom: 0.9rem; }
    .telo :global(table:has(td:nth-child(3)) td) { border: 0; padding: 0.15rem 0; }
    .telo :global(table:has(td:nth-child(3)) td:first-child) { font-family: var(--pismo-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-2); }
    .telo :global(table:has(td:nth-child(3)) td:last-child) { margin-top: 0.4rem; }
  }
</style>
