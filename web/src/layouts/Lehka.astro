---
// Lehká verze: čisté HTML bez obrázků, písem a skriptů pro slabé připojení.
import Analytics from '@vercel/analytics/astro';

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Víme, co dělat (lehká verze)</title>
    <meta name="robots" content="noindex" />
    <Analytics />
    <style is:inline>
      body{font:18px/1.55 system-ui,sans-serif;max-width:40em;margin:0 auto;padding:1em;color:#1d2b36;background:#fff}
      a{color:#1f5e6b}table{border-collapse:collapse}td,th{border:1px solid #999;padding:.3em .5em;text-align:left}
      .krok{border:2px solid #1d2b36;padding:.6em .9em;font-weight:700}mark{background:#ffe08a}
    </style>
  </head>
  <body>
    <p><a href="/lehka">Lehká verze</a> · <a href="/">Plná verze webu</a> · V nouzi volejte 112</p>
    <slot />
  </body>
</html>
