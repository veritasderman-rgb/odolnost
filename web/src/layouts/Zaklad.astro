---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Odber from '../components/Odber.astro';

interface Props {
  title: string;
  popis?: string;
  obrazek?: string;
  bezOdberu?: boolean;
}

const { title, popis = 'Klidně, pravdivě a prakticky: co by pro nás znamenala vážná krize, jak se o sebe a blízké postarat a jak poznat manipulaci.', obrazek = '/og/vychozi.png', bezOdberu = false } = Astro.props;
const plnyTitulek = title === 'Víme, co dělat' ? title : `${title} · Víme, co dělat`;
const kanonicka = new URL(Astro.url.pathname, Astro.site);
const cesta = Astro.url.pathname;
const aktivni = (prefix: string) => (cesta === prefix || cesta.startsWith(prefix + '/') ? 'page' : undefined);

const menu = [
  { href: '/zacit', nazev: 'Začít' },
  { href: '/scenar', nazev: 'Scénář' },
  { href: '/pribehy', nazev: 'Příběhy' },
  { href: '/priprav-se', nazev: 'Připrav se' },
  { href: '/manipulace', nazev: 'Manipulace' },
];
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{plnyTitulek}</title>
    <meta name="description" content={popis} />
    <link rel="canonical" href={kanonicka} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1f2328" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Víme, co dělat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={popis} />
    <meta property="og:url" content={kanonicka} />
    <meta property="og:image" content={new URL(obrazek, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline src="/js/nastaveni.js"></script>
  </head>
  <body>
    <a class="preskocit" href="#obsah">Přeskočit na obsah</a>
    <header class="hlavicka">
      <div class="obal radek">
        <a href="/" class="domu" aria-label="Víme, co dělat: úvodní stránka"><Logo /></a>
        <nav aria-label="Hlavní" class="menu">
          {menu.map((p) => <a href={p.href} aria-current={aktivni(p.href)}>{p.nazev}</a>)}
        </nav>
        <div class="nastroje">
          <a href="/hledat" class="ikona" aria-label="Hledat">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </a>
          <button type="button" class="ikona" id="velke-pismo" aria-pressed="false" title="Větší písmo">
            <span aria-hidden="true">A<span class="velke">A</span></span><span class="vizualne-skryte">Větší písmo</span>
          </button>
        </div>
      </div>
    </header>

    <main id="obsah">
      <slot />
    </main>

    <footer class="paticka">
      <div class="obal mrizka">
        <div>
          <Logo />
          <p>Osobní projekt Josefa Pavlovice o připravenosti na vážnou krizi, sestavený ze zahraničních příruček a veřejných zdrojů. Nejsem státní instituce: v krizi se řiďte pokyny hasičů, policie, záchranky, armády a obce. Praktické seznamy zásob najdete na státním webu <a href="https://www.72h.gov.cz/cs">72h.gov.cz</a>, na který navazujeme.</p>
          <p class="tisnove">V nouzi <a href="tel:112" class="c112">112</a><br />Sabotáž <a href="tel:158" class="c158">158</a></p>
        </div>
        <div>
          <p class="nadpis">O projektu</p>
          <ul>
            <li><a href="/o-nas/o-nas">Kdo za tím stojí</a></li>
            <li><a href="/o-nas/redakcni-pravidla">Redakční pravidla</a></li>
            <li><a href="/o-nas/opravy">Opravy</a></li>
            <li><a href="/o-nas/ochrana-soukromi">Ochrana soukromí</a></li>
            <li><a href="/oficialni-kanaly">Naše oficiální kanály</a></li>
          </ul>
        </div>
        <div>
          <p class="nadpis">Pro násobitele</p>
          <ul>
            <li><a href="/pro-media">Pro média</a></li>
            <li><a href="/pro-obce-a-skoly">Pro obce a školy</a></li>
            <li><a href="/lehka">Lehká verze webu</a></li>
          </ul>
        </div>
        {!bezOdberu && <div><Odber /></div>}
      </div>
      <div class="obal licence">
        <p>Obsah můžete volně šířit a upravovat pod licencí <a href="https://creativecommons.org/licenses/by/4.0/deed.cs" rel="license">CC BY 4.0</a> s uvedením zdroje „Víme, co dělat“. Nepoužíváme cookies ani sledovací nástroje.</p>
      </div>
    </footer>

    <nav class="spodni-lista" aria-label="Rychlá navigace">
      <a href="/zacit" aria-current={aktivni('/zacit')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Začít
      </a>
      <a href="/pribehy" aria-current={aktivni('/pribehy')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h7a2 2 0 012 2v12a2 2 0 00-2-2H4zM20 5h-7a2 2 0 00-2 2v12a2 2 0 012-2h7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>Příběhy
      </a>
      <a href="/priprav-se/rodinny-plan" class="plan" aria-current={aktivni('/priprav-se/rodinny-plan')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 8h6M9 12h6M9 16h3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Můj plán
      </a>
      <a href="/priprav-se" aria-current={aktivni('/priprav-se')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Připrav se
      </a>
      <a href="/manipulace" aria-current={aktivni('/manipulace')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Manipulace
      </a>
    </nav>
  </body>
</html>

<style>
  .hlavicka { background: var(--plocha); border-bottom: 2px solid var(--linka); position: sticky; top: 0; z-index: 10; }
  .radek { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 68px; }
  .domu { text-decoration: none; }
  .domu:hover { background: none; }
  .menu { display: flex; gap: 0; align-self: stretch; }
  .menu a { display: flex; align-items: center; color: var(--text); text-decoration: none; font-family: var(--pismo-nadpis); font-weight: 700; font-size: 1.2rem; padding: 0 0.9rem; border-bottom: 5px solid transparent; margin-bottom: -2px; }
  .menu a:hover { background: var(--akcent); color: var(--na-akcentu); }
  .menu a[aria-current='page'] { border-bottom-color: var(--akcent); }
  .nastroje { display: flex; gap: 0.25rem; }
  .ikona { display: inline-grid; place-items: center; width: 46px; height: 46px; border: 2px solid transparent; background: transparent; color: var(--text); font: inherit; font-weight: 700; cursor: pointer; }
  .ikona:hover { background: var(--akcent); color: var(--na-akcentu); }
  .ikona[aria-pressed='true'] { border-color: var(--linka); }
  .velke { font-size: 1.3em; }

  .paticka { background: var(--tmava); color: #e8e4da; margin-top: 5rem; padding: 3.5rem 0 6rem; font-size: 0.95rem; border-top: 8px solid var(--akcent); }
  .paticka a { color: #fff; }
  .paticka a:hover { background: var(--akcent); color: var(--na-akcentu); }
  .mrizka { display: grid; gap: 2.5rem; grid-template-columns: 2fr 1fr 1fr 2fr; }
  .paticka ul { list-style: none; padding: 0; margin: 0; }
  .paticka li { margin: 0.45rem 0; }
  .nadpis { font-family: var(--pismo-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--akcent-na-tmave); margin-top: 0; }
  .mensi { font-size: 0.9rem; }
  .tisnove { font-family: var(--pismo-nadpis); font-size: 1.5rem; font-weight: var(--nadpis-vaha); color: #fff; line-height: 1.1; }
  .tisnove a { text-decoration: none; }
  .tisnove .c112 { color: #ff7a1a; }
  .tisnove .c158 { color: #5aa9ff; }
  .paticka .tisnove a:hover { background: none; text-decoration: underline; }
  .paticka .tisnove .c112:hover { color: #ff7a1a; }
  .paticka .tisnove .c158:hover { color: #5aa9ff; }
  .licence { border-top: 1px solid #333; margin-top: 2.5rem; padding-top: 1rem; font-size: 0.85rem; color: #a8a49b; }

  .spodni-lista { display: none; }

  @media (max-width: 1000px) {
    .menu a { font-size: 1.05rem; padding: 0 0.55rem; }
    .mrizka { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 800px) {
    .menu { display: none; }
    .mrizka { grid-template-columns: 1fr; }
    .spodni-lista { display: grid; grid-template-columns: repeat(5, 1fr); position: fixed; bottom: 0; left: 0; right: 0; z-index: 20; background: var(--tmava); border-top: 2px solid var(--akcent); padding-bottom: env(safe-area-inset-bottom); }
    .spodni-lista a { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; padding: 0.5rem 0.2rem; font-family: var(--pismo-mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.02em; color: #fff; text-decoration: none; }
    .spodni-lista svg { width: 24px; height: 24px; }
    .spodni-lista a[aria-current='page'] { color: var(--akcent-na-tmave); }
    .spodni-lista .plan { color: var(--na-akcentu); background: var(--akcent); }
    .paticka { padding-bottom: 7rem; }
  }
</style>

<script>
  const tlacitko = document.getElementById('velke-pismo');
  const koren = document.documentElement;
  const nastav = (velke: boolean) => {
    if (velke) koren.dataset.pismo = 'velke';
    else delete koren.dataset.pismo;
    tlacitko?.setAttribute('aria-pressed', String(velke));
  };
  nastav(koren.dataset.pismo === 'velke');
  tlacitko?.addEventListener('click', () => {
    const velke = koren.dataset.pismo !== 'velke';
    nastav(velke);
    try { localStorage.setItem('vcd-pismo', velke ? 'velke' : ''); } catch {}
  });

  if ('serviceWorker' in navigator && location.protocol === 'https:') {
    navigator.serviceWorker.register('/sw.js').catch(() => {});
  }
</script>
