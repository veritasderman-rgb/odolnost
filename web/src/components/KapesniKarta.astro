---
import { TECHNIKY } from '../lib/karta';
---
<section class="karta-sekce" aria-labelledby="karta-nadpis">
  <h2 id="karta-nadpis">Kapesní karta</h2>
  <div class="karta" id="kapesni-karta">
    <div class="hlava"><p class="male">Víme, co dělat</p><p class="titul">Poznej manipulaci</p></div>
    </div>
    <ol>
      {TECHNIKY.map((t) => (
        <li><a href={`/manipulace/${t.slug}`}><strong>{t.nazev}</strong></a><span class="otazka">{t.otazka}</span></li>
      ))}
    </ol>
    <p class="pata">Než sdílíte: zastavte se, ověřte, zeptejte se. · vimecodelat.cz</p>
  </div>
  <div class="akce netisknout">
    <a class="tlacitko" href="/manipulace/karta-tisk">Vytisknout karty (8 na A4)</a>
    <a class="tlacitko svetle" href="/karta/poznej-manipulaci-telefon.png" download>Obrázek do telefonu</a>
  </div>
</section>

<style>
  .karta-sekce { margin: 2rem 0; }
  .karta { background: var(--tmava); color: #fff; border-top: 10px solid var(--akcent); padding: 1.3rem 1.4rem; max-width: 27rem; }
  .male { margin: 0; font-family: var(--pismo-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--akcent-na-tmave); }
  .titul { margin: 0.2rem 0 0; font-family: var(--pismo-nadpis); font-weight: var(--nadpis-vaha); font-size: 2.2rem; line-height: var(--nadpis-lh); }
  .karta ol { padding-left: 1.5rem; margin: 1rem 0; }
  .karta li { margin: 0.6rem 0; line-height: 1.3; }
  .karta li::marker { font-family: var(--pismo-mono); color: var(--akcent-na-tmave); }
  .karta a { color: #fff; }
  .karta a:hover { color: var(--na-akcentu); }
  .otazka { display: block; font-size: 0.95rem; color: #d9d5cc; }
  .pata { margin: 0; font-family: var(--pismo-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: #b5b0a6; }
  .akce { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem; }
</style>
