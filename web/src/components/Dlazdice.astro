---
import StitekPribehu from './StitekPribehu.astro';
interface Props { href: string; titulek: string; popis: string; barva?: string; druh?: 'modelovy' | 'svedectvi'; doplnek?: string; zvyraznit?: boolean; cislo?: string }
const { href, titulek, popis, druh, doplnek, zvyraznit = false, cislo } = Astro.props;
---
<a class:list={['dlazdice', { zvyraznit }]} href={href}>
  {(cislo || druh) && <span class="hlavicka">{cislo && <span class="cislo">{cislo}</span>}{druh && <StitekPribehu druh={druh} />}</span>}
  <span class="titulek">{titulek}</span>
  <span class="popis">{popis}</span>
  <span class="pata">{doplnek && <span class="doplnek">{doplnek}</span>}<span class="sipka" aria-hidden="true">→</span></span>
</a>
<style>
  .dlazdice { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.3rem 1.4rem 1.1rem; background: var(--plocha); border: 2px solid var(--linka); text-decoration: none; color: var(--text); }
  .dlazdice:hover { background: var(--akcent); color: var(--na-akcentu); }
  .zvyraznit { background: var(--tmava); color: #fff; border-color: var(--na-akcentu); }
  .zvyraznit:hover { background: var(--akcent); color: var(--na-akcentu); }
  .hlavicka { display: flex; gap: 0.6rem; align-items: center; }
  .cislo { font-family: var(--pismo-mono); font-size: 0.85rem; font-weight: 500; }
  .titulek { font-family: var(--pismo-nadpis); font-weight: var(--nadpis-vaha); font-size: 1.75rem; line-height: var(--nadpis-lh); }
  .popis { font-size: 0.98rem; line-height: 1.45; }
  .pata { display: flex; justify-content: space-between; align-items: end; margin-top: auto; padding-top: 0.4rem; }
  .doplnek { font-family: var(--pismo-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .sipka { margin-left: auto; font-size: 1.6rem; line-height: 1; font-weight: 700; }
</style>
