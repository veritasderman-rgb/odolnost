---
import StitekPribehu from './StitekPribehu.astro';
interface Props { href: string; titulek: string; popis: string; barva?: string; druh?: 'modelovy' | 'svedectvi'; doplnek?: string; zvyraznit?: boolean }
const { href, titulek, popis, barva = 'var(--inkoust)', druh, doplnek, zvyraznit = false } = Astro.props;
---
<a class:list={['dlazdice', { zvyraznit }]} href={href} style={`--barva: ${barva}`}>
  {druh && <StitekPribehu druh={druh} />}
  <span class="titulek">{titulek}</span>
  <span class="popis">{popis}</span>
  {doplnek && <span class="doplnek">{doplnek}</span>}
</a>
<style>
  .dlazdice { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.3rem 1.4rem; border-radius: var(--radius); background: var(--plocha); border: 1px solid var(--linka); border-top: 5px solid var(--barva); text-decoration: none; color: var(--text); transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .dlazdice:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgb(0 0 0 / 0.08); }
  .zvyraznit { background: var(--lampa); color: var(--inkoust); border-color: var(--lampa); }
  .titulek { font-weight: 700; font-size: 1.2rem; line-height: 1.3; }
  .popis { color: var(--text-2); font-size: 0.98rem; }
  .zvyraznit .popis { color: var(--inkoust); }
  .doplnek { font-size: 0.85rem; color: var(--text-2); margin-top: auto; }
</style>
