---
import { getCollection } from 'astro:content';
import type { Pilir } from '../lib/pilire';
interface Props { pilir: Pilir; aktualni: string }
const { pilir, aktualni } = Astro.props;
const vse = (await getCollection('obsah', (s) => s.id.startsWith(pilir + '/'))).sort((a, b) => a.data.poradi - b.data.poradi);
const i = vse.findIndex((s) => s.id === aktualni);
const dalsi = vse[i + 1];
---
{dalsi && (
  <nav class="dalsi netisknout" aria-label="Pokračovat" data-pagefind-ignore>
    <a href={`/${dalsi.id}`}>
      <span class="popisek">Pokračovat</span>
      <span class="nazev">{dalsi.data.title} →</span>
    </a>
  </nav>
)}
<style>
  .dalsi { margin-top: 2.5rem; max-width: var(--sirka-textu); }
  .dalsi a { display: block; padding: 1.2rem 1.4rem; border: 2px solid var(--linka); text-decoration: none; color: var(--text); background: var(--plocha); }
  .dalsi a:hover { background: var(--akcent); color: var(--na-akcentu); }
  .popisek { display: block; font-family: var(--pismo-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: inherit; }
  .nazev { font-family: var(--pismo-nadpis); font-weight: var(--nadpis-vaha); font-size: 1.7rem; line-height: var(--nadpis-lh); }
</style>
