---
import { PILIRE, type Pilir } from '../lib/pilire';
interface Props { pilir: Pilir }
const { pilir } = Astro.props;
---
<nav aria-label="Drobečková navigace" class="drobky netisknout" data-pagefind-ignore>
  <a href="/">Úvod</a> <span aria-hidden="true">›</span> <a href={`/${pilir}`}>{PILIRE[pilir].nazev}</a>
</nav>
<style>
  .drobky { font-family: var(--pismo-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-2); margin-bottom: 1.5rem; }
  .drobky a { color: var(--text-2); }
</style>
