---
// Pracovní slovní značka. Nahradí ji finální logo od designéra.
interface Props { velikost?: number; sNazvem?: boolean }
const { sNazvem = true } = Astro.props;
---
<span class="logo">
  <span class="znak" aria-hidden="true"></span>
  {sNazvem && <span class="nazev">Víme, co dělat</span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; }
  .znak { width: 1.1rem; height: 1.1rem; background: var(--akcent); }
  .nazev { font-family: var(--pismo-nadpis); font-weight: var(--nadpis-vaha); font-size: 1.45rem; letter-spacing: var(--nadpis-tracking); line-height: 1; color: var(--text); }
  :global(.paticka) .nazev { color: #fff; }
</style>
