---
interface Props { druh?: 'modelovy' | 'svedectvi' }
const { druh } = Astro.props;
---
{druh === 'modelovy' && (
  <span class="stitek" style="color: var(--terakota)" title="Fiktivní postava v realistické situaci">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 20l4-1 10-10-3-3L5 16l-1 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
    Modelový příběh
  </span>
)}
{druh === 'svedectvi' && (
  <span class="stitek" style="color: var(--petrol)" title="Skutečný rozhovor se souhlasem">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 11a7 7 0 0014 0M12 18v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    Skutečné svědectví
  </span>
)}
