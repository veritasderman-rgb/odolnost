---
interface Zdroj { nazev: string; url?: string; datum?: string | number }
interface Props { zdroje: Zdroj[] }
const { zdroje } = Astro.props;
---
{zdroje.length > 0 && (
  <details class="odkud">
    <summary>Odkud to víme <span>({zdroje.length} {zdroje.length === 1 ? 'zdroj' : zdroje.length < 5 ? 'zdroje' : 'zdrojů'})</span></summary>
    <ul>
      {zdroje.map((z) => (
        <li>{z.url ? <a href={z.url} rel="noopener">{z.nazev}</a> : z.nazev}{z.datum && <span class="datum"> · {z.datum}</span>}</li>
      ))}
    </ul>
  </details>
)}
<style>
  .odkud { max-width: var(--sirka-textu); border-top: 2px solid var(--linka); border-bottom: 2px solid var(--linka); padding: 0.9rem 0; margin: 2rem 0; font-size: 0.95rem; }
  summary { cursor: pointer; font-family: var(--pismo-mono); font-weight: 500; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
  summary span { font-weight: 400; color: var(--text-2); }
  ul { margin: 0.75rem 0 0; padding-left: 1.2rem; }
  li { margin: 0.35rem 0; }
  .datum { color: var(--text-2); }
  @media print { .odkud { display: block; } .odkud ul { display: block; } }
</style>
