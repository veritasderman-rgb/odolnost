---
interface Props { text: string }
const { text } = Astro.props;
---
<aside class="krok" aria-label="Krok na dnes">
  <p class="nadpis">Krok na dnes</p>
  <p class="obsah">{text}</p>
</aside>
<style>
  .krok { background: var(--akcent); color: var(--na-akcentu); border: 2px solid var(--text); box-shadow: 8px 8px 0 var(--text); padding: 1.3rem 1.5rem 1.4rem; margin: 3rem 0; max-width: var(--sirka-textu); }
  .nadpis { margin: 0 0 0.4rem; font-family: var(--pismo-mono); font-weight: 500; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .nadpis::before { content: '→ '; }
  .obsah { margin: 0; font-family: var(--pismo-nadpis); font-weight: var(--nadpis-vaha); font-size: clamp(1.5rem, 3vw, 1.9rem); line-height: var(--nadpis-lh); }
  @media print { .krok { box-shadow: none; background: #fff; } }
</style>
